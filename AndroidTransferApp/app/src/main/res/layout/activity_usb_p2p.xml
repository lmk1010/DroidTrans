<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    tools:context=".UsbP2PActivity">

    <!-- 顶部标题区域 -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/text_high_emphasis"
            app:iconSize="24dp"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB 点对点传输"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/text_high_emphasis" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="选择您的角色"
                android:textSize="14sp"
                android:textColor="@color/text_medium_emphasis" />
        </LinearLayout>
    </LinearLayout>

    <!-- 主滚动区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/titleContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 角色选择卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRoleSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 请选择您的角色"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high_emphasis" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="两台手机都需要安装本应用\n请先选择角色，然后再连接USB数据线"
                        android:textSize="14sp"
                        android:textColor="@color/text_medium_emphasis"
                        android:lineSpacingExtra="4dp" />

                    <!-- 发送端卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSender"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <!-- 渐变背景 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/card_gradient_phone_usb" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="20dp"
                            android:gravity="center_vertical">

                            <!-- 图标容器 -->
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/icon_bg_phone_transfer">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_send_simple"
                                    android:tint="@color/white"
                                    android:contentDescription="发送端" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSenderTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="作为发送端"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/white" />

                                <TextView
                                    android:id="@+id/tvSenderDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="选择文件并发送到对方手机"
                                    android:textSize="13sp"
                                    android:textColor="@color/white"
                                    android:alpha="0.9" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 接收端卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardReceiver"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <!-- 渐变背景 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/card_gradient_phone_usb" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="20dp"
                            android:gravity="center_vertical">

                            <!-- 图标容器 -->
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/icon_bg_phone_transfer">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_receive_simple"
                                    android:tint="@color/white"
                                    android:contentDescription="接收端" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvReceiverTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="作为接收端"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/white" />

                                <TextView
                                    android:id="@+id/tvReceiverDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="等待接收对方发送的文件"
                                    android:textSize="13sp"
                                    android:textColor="@color/white"
                                    android:alpha="0.9" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 文件选择卡片（发送端显示） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFileSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvFileSelectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未选择文件"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high_emphasis" />

                    <TextView
                        android:id="@+id/tvFileSelectionDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="请选择要传输的照片、视频或文件"
                        android:textSize="14sp"
                        android:textColor="@color/text_medium_emphasis" />

                    <!-- 文件选择按钮 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectPhotos"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="照片"
                            android:textSize="14sp"
                            app:icon="@drawable/ic_photo_simple"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectVideos"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="视频"
                            android:textSize="14sp"
                            app:icon="@drawable/ic_video_simple"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectFiles"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="其他文件"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_folder_simple"
                        app:iconGravity="textStart" />

                    <!-- 开始传输按钮 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartTransfer"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="开始传输"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:enabled="false"
                        app:backgroundTint="@color/radar_blue_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 使用说明 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 使用说明"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high_emphasis" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1. 两台手机都需要安装本应用\n2. 先在两台手机选择角色（一个发送，一个接收）\n3. 角色选择后再连接USB数据线\n4. 使用支持OTG功能的数据线\n5. 如果连接失败，尝试重新插拔数据线"
                        android:textSize="13sp"
                        android:textColor="@color/text_medium_emphasis"
                        android:lineSpacingExtra="4dp" />
                    
                    <!-- 关闭反向充电按钮 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#FFB74D"
                        app:cardBackgroundColor="#FFF3E0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️ 重要提示"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#F57C00" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="连接前必须关闭反向充电功能，否则无法正常使用"
                                android:textSize="12sp"
                                android:textColor="#E65100" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDisableOtgCharging"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="📱 去关闭反向充电"
                                android:textSize="13sp"
                                app:backgroundTint="#FF9800"
                                app:icon="@drawable/ic_settings"
                                app:iconGravity="textStart" />
                            
                            <!-- 检测RNDIS支持按钮 -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCheckRndis"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="🔍 检测USB网络支持"
                                android:textSize="13sp"
                                app:backgroundTint="@color/radar_blue_primary"
                                app:icon="@drawable/ic_usb_cable"
                                app:iconGravity="textStart" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 悬浮日志窗口 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDebugLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="visible"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#F5F5F5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 标题栏 - 可点击折叠 -->
            <LinearLayout
                android:id="@+id/logHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@color/radar_blue_primary"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 连接日志"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
                
                <TextView
                    android:id="@+id/tvLogStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击折叠"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/ivLogToggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_up"
                    android:tint="@color/white"
                    android:contentDescription="折叠/展开" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearLog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:text="清空"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- 日志内容区域 -->
            <ScrollView
                android:id="@+id/scrollViewLog"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvDebugLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="等待连接...\n"
                    android:textSize="11sp"
                    android:textColor="@color/text_high_emphasis"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
