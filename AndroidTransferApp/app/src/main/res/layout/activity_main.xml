<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- 顶部标题区域 -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_high_emphasis"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWifiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi 传输"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/text_high_emphasis" />

            <TextView
                android:id="@+id/tvWifiSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="扫描并连接同一网络下的服务器"
                android:textSize="14sp"
                android:textColor="@color/text_medium_emphasis" />

        </LinearLayout>

        <!-- 历史记录按钮 - 扁平精致 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_history_refined"
            app:iconTint="@color/radar_blue_primary"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="22dp"
            app:backgroundTint="@color/radar_button_bg"
            app:rippleColor="@color/radar_blue_light"
            app:strokeWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="历史记录" />

    </LinearLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/titleContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <!-- Radar Scanning View - 无背景卡片，直接融入页面 -->
            <FrameLayout
                android:id="@+id/radarContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_max="420dp">

                <!-- 外部光晕效果层 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radar_outer_glow" />

                <!-- Radar Background Circle with gradient -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:background="@drawable/radar_background_enhanced" />

                <!-- Custom Radar View with Server Dots -->
                <com.mk.androidtransfer.widget.RadarScanView
                    android:id="@+id/radarScanView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp" />

                <!-- Center Glow Effect -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/center_glow_effect" />

                <!-- Center Device Icon -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_smartphone"
                    android:tint="@color/radar_blue_primary"
                    android:elevation="4dp"
                    android:contentDescription="本设备" />

            </FrameLayout>

            <!-- Device Name Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textSize="14sp"
                android:textColor="@color/text_high_emphasis"
                app:chipBackgroundColor="@color/radar_chip_bg"
                app:chipStrokeColor="@color/radar_blue_primary"
                app:chipStrokeWidth="2dp"
                app:chipIconTint="@color/radar_blue_primary"
                app:chipIcon="@drawable/ic_smartphone"
                app:chipCornerRadius="24dp"
                android:elevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/radarContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="优雅的天鹅-AB12" />

            <!-- Status Text -->
            <TextView
                android:id="@+id/tvScanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="正在扫描服务器..."
                android:textSize="16sp"
                android:textColor="@color/text_high_emphasis"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/chipDeviceName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Scan Hint -->
            <TextView
                android:id="@+id/tvScanHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="请确保设备在同一网络下"
                android:textSize="13sp"
                android:textColor="@color/text_medium_emphasis"
                app:layout_constraintTop_toBottomOf="@id/tvScanStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:id="@+id/actionButtonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/tvScanHint"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefresh"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:text="刷新扫描"
                    android:textSize="13sp"
                    android:textColor="@color/radar_blue_primary"
                    app:strokeColor="@color/radar_blue_primary"
                    app:icon="@android:drawable/ic_menu_rotate"
                    app:iconTint="@color/radar_blue_primary"
                    app:iconSize="18dp"
                    app:cornerRadius="22dp" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManualInput"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="手动输入"
                    android:textSize="13sp"
                    android:textColor="@color/radar_blue_primary"
                    app:strokeColor="@color/radar_blue_primary"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/radar_blue_primary"
                    app:iconSize="18dp"
                    app:cornerRadius="22dp" />
                
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
