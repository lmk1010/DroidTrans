<?xml version="1.0" encoding="utf-8"?>
<!-- 精致的传输记录卡片背景 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 阴影层 -->
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- 主卡片 -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
        </shape>
    </item>
    
    <!-- 顶部蓝色装饰线 -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
            <size android:height="3dp" />
            <solid android:color="@color/radar_blue_primary" />
        </shape>
    </item>
    
</layer-list>

