<?xml version="1.0" encoding="utf-8"?>
<!-- 增强版雷达背景 - 带渐变和描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 外层阴影效果 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#10000000" />
            <size android:width="4dp" android:height="4dp" />
        </shape>
    </item>
    
    <!-- 主背景 - 渐变效果 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#1A2196F3"
                android:centerColor="#0F2196F3"
                android:endColor="#052196F3" />
            
            <stroke
                android:width="2dp"
                android:color="#402196F3" />
        </shape>
    </item>
    
    <!-- 内层高光 -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#662196F3" />
        </shape>
    </item>
    
</layer-list>

