{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroidTrans",
  "version": "1.0.0",
  "identifier": "com.mk.droidtrans",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "title": "DroidTrans / 卓传",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": [
      "../../web/app.py",
      "../../web/fast_transfer.py",
      "../../web/templates",
      "../../web/static"
    ]
  }
}
