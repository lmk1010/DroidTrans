<?xml version="1.0" encoding="utf-8"?>
<!--
  找电脑。和 iOS 端 ConnectView 同一套结构：
  左上角 home、居中标题与状态、中间雷达、底部两个兜底入口。

  底下那两个入口必须一直留着：路由器拦掉组播的情况不少见，
  只留雷达就等于没得救。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/peer_back"
            android:src="@drawable/ic_home_24"
            app:tint="@color/brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/connect_status_scanning"
            android:textColor="@color/ink2"
            android:textSize="15sp" />

        <com.mk.androidtransfer.widget.RadarScanView
            android:id="@+id/radar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/connect_hint"
            android:textColor="@color/ink3"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="26dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/connect_scan"
                android:textColor="@color/ink"
                app:icon="@drawable/ic_qr_24"
                app:iconTint="@color/ink2"
                app:strokeColor="@color/glass_stroke" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManual"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/connect_manual"
                android:textColor="@color/ink"
                app:icon="@drawable/ic_keyboard_24"
                app:iconTint="@color/ink2"
                app:strokeColor="@color/glass_stroke" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
