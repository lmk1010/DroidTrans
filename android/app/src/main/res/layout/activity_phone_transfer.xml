<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingTop="@dimen/page_gutter_top"
    android:paddingBottom="12dp"
    tools:context=".PhoneTransferActivity">

    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_high_emphasis" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.AndroidTransfer.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_transfer_title" />

            <TextView
                style="@style/TextAppearance.AndroidTransfer.PageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/phone_transfer_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <com.mk.androidtransfer.view.SimpleLineAnimationView
        android:id="@+id/lineAnimation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/cardsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cardUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/entry_row_min"
            android:layout_marginBottom="@dimen/entry_row_gap"
            android:background="@drawable/bg_entry_row"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="@dimen/entry_icon_well"
                android:layout_height="@dimen/entry_icon_well">

                <ImageView
                    android:id="@+id/iconUsb"
                    android:layout_width="@dimen/entry_icon"
                    android:layout_height="@dimen/entry_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/p2p_usb_title"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_usb_modern"
                    android:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.AndroidTransfer.EntryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p2p_usb_title" />

                <TextView
                    style="@style/TextAppearance.AndroidTransfer.EntrySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/p2p_usb_subtitle" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/entry_chevron"
                android:layout_height="@dimen/entry_chevron"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_disabled"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/entry_row_min"
            android:alpha="0.55"
            android:background="@drawable/bg_entry_row"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="@dimen/entry_icon_well"
                android:layout_height="@dimen/entry_icon_well">

                <ImageView
                    android:id="@+id/iconWifi"
                    android:layout_width="@dimen/entry_icon"
                    android:layout_height="@dimen/entry_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/p2p_wireless_title"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wifi_modern"
                    android:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.AndroidTransfer.EntryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p2p_wireless_title" />

                <TextView
                    style="@style/TextAppearance.AndroidTransfer.EntrySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/coming_soon" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/entry_chevron"
                android:layout_height="@dimen/entry_chevron"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_disabled"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
