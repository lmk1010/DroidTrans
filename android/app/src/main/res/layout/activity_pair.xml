<?xml version="1.0" encoding="utf-8"?>
<!--
  输配对码。六位数字做成分格输入 ——
  一个普通输入框在这里会让人不确定该填几位。

  真正接收输入的是那个 1dp 的透明输入框，六个格子只负责显示。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:src="@drawable/art_shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/pair_screen_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink2"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="@string/pair_hint"
            android:textColor="@color/ink2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/codeBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">
        <TextView
            android:layout_width="46dp"
            android:layout_height="58dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/code_box"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="46dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/code_box"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="46dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/code_box"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="46dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/code_box"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="46dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/code_box"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="46dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/code_box"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/codeSink"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.01"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/pair_cancel"
            android:textColor="@color/ink2" />
    </LinearLayout>
</FrameLayout>
