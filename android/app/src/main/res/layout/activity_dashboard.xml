<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingTop="@dimen/page_gutter_top"
    android:paddingBottom="16dp"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/page_header_icon"
            android:layout_height="@dimen/page_header_icon"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="DroidTrans"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="卓传"
                android:textSize="13sp"
                android:textColor="@color/text_medium_emphasis" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWelcomeTitle"
        style="@style/TextAppearance.AndroidTransfer.PageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/home_title"
        android:textSize="24sp"
        android:lineSpacingMultiplier="1.1" />

    <com.mk.androidtransfer.view.DataTransferAnimationView
        android:id="@+id/dataTransferAnimation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/cardUsb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/entry_row_min"
        android:layout_marginBottom="@dimen/entry_row_gap"
        android:background="@drawable/bg_entry_row"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="@dimen/entry_icon_well"
            android:layout_height="@dimen/entry_icon_well">

            <ImageView
                android:layout_width="@dimen/entry_icon"
                android:layout_height="@dimen/entry_icon"
                android:layout_gravity="center"
                android:src="@drawable/ic_usb_modern"
                android:scaleType="fitCenter"
                android:tint="@color/primary"
                android:contentDescription="@string/card_usb_title" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.AndroidTransfer.EntryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_usb_title" />

            <TextView
                android:id="@+id/tvUsbStatus"
                style="@style/TextAppearance.AndroidTransfer.EntrySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/card_usb_subtitle" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/entry_chevron"
            android:layout_height="@dimen/entry_chevron"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_disabled"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardWifi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/entry_row_min"
        android:layout_marginBottom="@dimen/entry_row_gap"
        android:background="@drawable/bg_entry_row"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="@dimen/entry_icon_well"
            android:layout_height="@dimen/entry_icon_well">

            <ImageView
                android:layout_width="@dimen/entry_icon"
                android:layout_height="@dimen/entry_icon"
                android:layout_gravity="center"
                android:src="@drawable/ic_wifi_modern"
                android:scaleType="fitCenter"
                android:tint="@color/primary"
                android:contentDescription="@string/card_wifi_title" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.AndroidTransfer.EntryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_wifi_title" />

            <TextView
                android:id="@+id/tvWifiStatus"
                style="@style/TextAppearance.AndroidTransfer.EntrySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/card_wifi_subtitle" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/entry_chevron"
            android:layout_height="@dimen/entry_chevron"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_disabled"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardReceive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/entry_row_min"
        android:layout_marginBottom="@dimen/entry_row_gap"
        android:background="@drawable/bg_entry_row"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="@dimen/entry_icon_well"
            android:layout_height="@dimen/entry_icon_well">

            <ImageView
                android:layout_width="@dimen/entry_icon"
                android:layout_height="@dimen/entry_icon"
                android:layout_gravity="center"
                android:src="@drawable/ic_download_modern"
                android:scaleType="fitCenter"
                android:tint="@color/primary"
                android:contentDescription="@string/card_receive_title" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.AndroidTransfer.EntryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_receive_title" />

            <TextView
                android:id="@+id/tvReceiveCardStatus"
                style="@style/TextAppearance.AndroidTransfer.EntrySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/card_receive_subtitle" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/entry_chevron"
            android:layout_height="@dimen/entry_chevron"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_disabled"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardPhoneToPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/entry_row_min"
        android:background="@drawable/bg_entry_row"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="@dimen/entry_icon_well"
            android:layout_height="@dimen/entry_icon_well">

            <ImageView
                android:layout_width="@dimen/entry_icon"
                android:layout_height="@dimen/entry_icon"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone_transfer_modern"
                android:scaleType="fitCenter"
                android:tint="@color/primary"
                android:contentDescription="@string/card_phone_title" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.AndroidTransfer.EntryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_phone_title" />

            <TextView
                style="@style/TextAppearance.AndroidTransfer.EntrySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/card_phone_subtitle" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/entry_chevron"
            android:layout_height="@dimen/entry_chevron"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_disabled"
            android:importantForAccessibility="no" />
    </LinearLayout>

</LinearLayout>
