<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".PhotoSelectionActivity">

    <!-- 顶部标题区域 -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginEnd="@dimen/page_gutter"
        android:layout_marginTop="@dimen/page_gutter_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_high_emphasis"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPhotoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvPhotoSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/browse_photos"
                android:textSize="14sp"
                android:textColor="@color/text_medium_emphasis" />

        </LinearLayout>

        <!-- 已选数量 -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipSelectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selected_count_zero"
            android:textSize="14sp"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/radar_blue_primary"
            app:chipStrokeWidth="0dp"
            tools:text="已选 5" />

        <!-- 视图切换按钮 -->
        <ImageButton
            android:id="@+id/btnViewMode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_view_grid"
            android:tint="@color/text_high_emphasis"
            android:contentDescription="@string/switch_view" />

    </LinearLayout>

    <!-- 操作按钮区域 -->
    <HorizontalScrollView
        android:id="@+id/actionButtonsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/titleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToday"
                style="@style/Widget.AndroidTransfer.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/select_today"
                android:textSize="13sp"
                android:textColor="@color/primary"
                app:iconTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeek"
                style="@style/Widget.AndroidTransfer.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/select_week"
                android:textSize="13sp"
                android:textColor="@color/primary"
                app:iconTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.AndroidTransfer.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/select_all"
                android:textSize="13sp"
                android:textColor="@color/primary"
                app:iconTint="@color/primary"
                app:icon="@drawable/ic_check_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeselectAll"
                style="@style/Widget.AndroidTransfer.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/deselect_all"
                android:textSize="13sp"
                android:textColor="@color/primary"
                app:iconTint="@color/primary"
                app:icon="@drawable/ic_check_none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSort"
                style="@style/Widget.AndroidTransfer.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/sort"
                android:textSize="13sp"
                android:textColor="@color/primary"
                app:iconTint="@color/primary"
                app:icon="@drawable/ic_sort" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterUploaded"
                style="@style/Widget.AndroidTransfer.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/exclude_uploaded"
                android:textSize="13sp"
                android:textColor="@color/primary"
                app:iconTint="@color/primary"
                app:icon="@drawable/ic_filter" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- 相册列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAlbums"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/actionButtonsScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 照片网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPhotos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/actionButtonsScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_photo_grid"
        tools:itemCount="20"
        tools:spanCount="3" />

    <!-- 加载中状态 -->
    <FrameLayout
        android:id="@+id/loadingContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/radar_blue_primary"
                app:trackColor="@android:color/transparent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/loading_photos_short"
                android:textSize="14sp"
                android:textColor="@color/text_medium_emphasis" />

        </LinearLayout>

    </FrameLayout>

    <!-- 空状态 -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="@id/recyclerViewPhotos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_no_photos"
            android:alpha="0.3"
            android:contentDescription="@string/no_photos" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/no_photos_found_title"
            android:textSize="18sp"
            android:textColor="@color/text_high_emphasis"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_photos_on_device"
            android:textSize="14sp"
            android:textColor="@color/text_medium_emphasis"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- 上传按钮 -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/upload_photos"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        app:icon="@drawable/ic_upload"
        app:iconTint="@color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="28dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
