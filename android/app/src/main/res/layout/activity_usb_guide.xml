<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <!-- 顶部标题区域 -->
        <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:tint="#1A1F36"
                android:contentDescription="@string/usb_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usb_guide_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/text_high_emphasis" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/usb_guide_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/text_medium_emphasis" />

            </LinearLayout>

        </LinearLayout>

        <!-- 设备信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/titleContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 蓝色渐变背景 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_gradient_usb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/usb_device_info"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1F36" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshStatus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="#EEF2FF"
                        app:icon="@drawable/ic_sort"
                        app:iconTint="#4C6FFF"
                        app:iconSize="20dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        style="@style/Widget.Material3.Button.IconButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tvDebugStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/usb_status_disabled"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#EF4444"
                        android:minWidth="80dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:clickable="false"
                        android:focusable="false"
                        app:cornerRadius="10dp"
                        app:backgroundTint="#FEF2F2"
                        style="@style/Widget.Material3.Button.TonalButton" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeviceBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/usb_device_brand"
                    android:textSize="13sp"
                    android:textColor="#4A5568" />

                <TextView
                    android:id="@+id/tvDeviceModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/usb_device_model"
                    android:textSize="13sp"
                    android:textColor="#4A5568" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 动画区域 - 减少上下空白 -->
        <FrameLayout
            android:id="@+id/animationContainer"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardDeviceInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.mk.androidtransfer.view.UsbDebugAnimationView
                android:id="@+id/usbDebugAnimation"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- 通用开启步骤 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGenericSteps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="0dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/animationContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 渐变背景 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_gradient_usb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#4C6FFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/usb_general_steps_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#1A1F36" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/usb_general_steps_content"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#4A5568" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenDevSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/usb_open_dev_settings"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#4C6FFF"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="end"
                    app:iconTint="#FFFFFF"
                    style="@style/Widget.Material3.Button" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 品牌特定步骤 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBrandSpecific"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/cardGenericSteps"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#818CF8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/usb_brand_specific_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high_emphasis" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBrandSpecificSteps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/text_medium_emphasis" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 额外提示 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/cardBrandSpecific"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#A5B4FC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/usb_tips_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_high_emphasis" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/usb_tips_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_medium_emphasis" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyBuildNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/usb_copy_path"
                    android:textSize="12sp"
                    android:textColor="#4C6FFF"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#EEF2FF"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="#4C6FFF"
                    style="@style/Widget.Material3.Button.TonalButton" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
