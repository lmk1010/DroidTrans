<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AndroidTransfer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_high_emphasis</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_high_emphasis</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="materialCardViewStyle">@style/Widget.AndroidTransfer.FlatCard</item>
    </style>

    <style name="Theme.AndroidTransfer" parent="Base.Theme.AndroidTransfer" />

    <!--
      深色主题。新做的几屏（主界面、手机互传）用它，和 iOS 端一个调子。
      存量页面还挂在上面那套浅色主题上，逐屏迁过来。

      状态栏和导航栏都透明，内容自己往里缩 —— 深色底一直铺到屏幕边缘，
      中间夹一条灰色系统栏会把整屏切成两段。
    -->
    <style name="Theme.DroidTrans.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg1</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/bg0</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@drawable/bg_dark</item>
        <!-- 弹窗跟着一起走深色。不设这一条，AlertDialog 会退回系统默认的
             浅色卡片，在整屏深色里白得刺眼 —— 一眼就看出是「另一个 App」。 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DroidTrans.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.DroidTrans.Dialog</item>
    </style>

    <!--
      深色弹窗。圆角、玻璃底、品牌蓝的确认键。

      走主题而不是每个弹窗单独打补丁：手输地址、发送文字、敲门确认
      是三处不同的代码，样式却该是同一套。
    -->
    <style name="ThemeOverlay.DroidTrans.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#1B2130</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink2</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DroidTrans.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">
            @style/TextAppearance.DroidTrans.DialogTitle
        </item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DroidTrans.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DroidTrans.Dialog.Negative</item>
    </style>

    <style name="ShapeAppearance.DroidTrans.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="TextAppearance.DroidTrans.DialogTitle"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 确认键是实心的品牌蓝：同意/连接这类动作要一眼看得出主次，
         两个一样淡的文字按钮会让人犹豫按哪个 -->
    <style name="Widget.DroidTrans.Dialog.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.DroidTrans.Dialog.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ink2</item>
    </style>

    <style name="MemberValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <style name="Widget.AndroidTransfer.FlatCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">0dp</item>
    </style>

    <style name="Widget.AndroidTransfer.TextAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <style name="TextAppearance.AndroidTransfer.PageTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_high_emphasis</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.AndroidTransfer.PageSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_medium_emphasis</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.AndroidTransfer.EntryTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_high_emphasis</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.AndroidTransfer.EntrySubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_medium_emphasis</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.AndroidTransfer.BarAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/radar_blue_primary</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
