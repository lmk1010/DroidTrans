{
  "name": "android-transfer",
  "version": "1.0.0",
  "description": "Android照片传输工具 - WiFi/USB传输客户端",
  "main": "electron_main.js",
  "author": "MK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MK-CO/AndroidTransfer.git"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging --v=1",
    "start:verbose": "electron . --enable-logging --v=2 --log-level=0",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "build:backend": "bash build_backend.sh",
    "build:backend:win": "build_backend.bat",
    "build:all": "bash build_all.sh",
    "build:all:win": "build_all.bat",
    "logs": "tail -f ~/Documents/AndroidTransfer/logs/electron-*.log"
  },
  "build": {
    "appId": "com.mk.androidtransfer",
    "productName": "Android Transfer",
    "directories": {
      "output": "dist",
      "buildResources": "build_resources"
    },
    "files": [
      "electron_main.js",
      "templates/**/*",
      "static/**/*",
      "install_macos.sh",
      "!build_*.{sh,bat}",
      "!app.spec",
      "!venv/**/*",
      "!dist_app",
      "!build",
      "!*.pyc",
      "!__pycache__"
    ],
    "extraResources": [
      {
        "from": "dist_app",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "Apple Development: mingkang liu (VB3DDX8YB9)",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Android Transfer ${version}",
      "background": null,
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Android Transfer",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "license": "LICENSE.txt"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}",
      "desktop": {
        "Name": "Android Transfer",
        "Comment": "Transfer photos from Android devices",
        "Categories": "Utility;FileTransfer;"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "MK-CO",
      "repo": "AndroidTransfer",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {}
}
